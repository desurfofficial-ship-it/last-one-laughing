  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/ws-transport": "^0.18.4",
    "express": "^5.3.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "typescript": "~5.9.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
