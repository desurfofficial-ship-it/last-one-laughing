{
  "name": "@lol/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Authoritative multiplayer server for Last One Laughing (rooms, tokens, 30 Hz sim via the shared RoundEngine, 20 Hz snapshots).",
  "scripts": {
